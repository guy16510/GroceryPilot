PORT=8080
DATA_DIR=/data
# Required: generate a strong random password. No default.
APP_PASSWORD=
# Optional: https URL for notifications, or local HA-accessible URL.
PUBLIC_URL=
HA_URL=
HA_TOKEN=
HA_NOTIFY_SERVICE=
# Example service: notify/mobile_app_phone (not notify.mobile_app_phone)
# Leave blank to disable weekly notification. Local timezone:
TZ=America/New_York
REVIEW_DAY=5
REVIEW_HOUR=9
# Optional shared secret for read-only HA REST dashboard; defaults to APP_PASSWORD.
